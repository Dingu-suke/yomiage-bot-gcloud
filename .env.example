# このファイルをコピーして .env を作り、値を埋める
#   cp .env.example .env
# .env と gcp-key.json は .gitignore 済み。絶対に commit しないこと。

# Discord Developer Portal → Bot タブ → Reset Token で発行した値
DISCORD_TOKEN=

# 話者（ja-JP-Neural2-B/C = 男性, D = 女性, Standard-A〜D = 軽量）
GCP_VOICE_NAME=ja-JP-Neural2-B
GCP_LANGUAGE_CODE=ja-JP

# 0.25 〜 4.0
GCP_SPEAKING_RATE=1.0
